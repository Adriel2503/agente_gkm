# =============================================================================
# AutoBot - AIYOU
# Copiar como .env y reemplazar los valores marcados con <REEMPLAZAR>
# =============================================================================

# --- OpenAI / Azure OpenAI ---
# OPENAI_API_KEY es obligatoria (sin ella /health devuelve 503).
OPENAI_API_KEY=<REEMPLAZAR>
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.5
OPENAI_TIMEOUT=60
MAX_TOKENS=2048
# Endpoint OpenAI-compatible. Vacío = OpenAI directo (api.openai.com).
# Para Azure OpenAI (endpoint unificado v1):
#   OPENAI_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
#   OPENAI_API_KEY=<azure-api-key>
#   OPENAI_MODEL=<nombre-del-deployment>   (p.ej. gpt-5.4-mini)
OPENAI_BASE_URL=

# --- Servidor ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8002
CHAT_TIMEOUT=120

# --- Logging ---
# Niveles: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_FILE=                         # Vacío = solo stdout. Si se pone ruta: RotatingFileHandler (10MB x 5 backups)

# --- HTTP y reintentos ---
API_TIMEOUT=10
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_WAIT_MIN=1
HTTP_RETRY_WAIT_MAX=4

# --- Circuit breaker (threshold fallos → abierto; reset tras TTL segundos) ---
CB_THRESHOLD=3
CB_RESET_TTL=300
CB_MAX_KEYS=500

# --- HTTP connection pool ---
HTTP_MAX_CONNECTIONS=50
HTTP_MAX_KEEPALIVE=20

# --- Cache (minutos / maxsize) ---
AGENT_CACHE_TTL_MINUTES=60
AGENT_CACHE_MAXSIZE=500
# SEARCH_CACHE_*: reservadas — cargadas en config.py pero sin consumidor activo
SEARCH_CACHE_TTL_MINUTES=15
SEARCH_CACHE_MAXSIZE=2000
MAX_MESSAGES_HISTORY=20

# --- Base de datos y Redis ---
# DATABASE_URL=postgresql://user:password@host:5432/autobot
REDIS_URL=
REDIS_CHECKPOINT_TTL_HOURS=24  # 0 = sin TTL (no expiran), default 24h
PROMPT_REDIS_TIMEOUT_SECONDS=2.0  # timeout lectura prompt:ver/prompt:txt (fallback al .j2 si Redis cuelga)

# --- Callback (URL donde se envia la respuesta del agente) ---
CALLBACK_URL=

# --- Zona horaria ---
# TIMEZONE: usada por Python para el DEADLINE de Vitrix y prompts.
# Distinta de TZ (variable del SO/libc, fijada en el Dockerfile a America/Lima),
# que controla los timestamps de los logs. Mantenerlas sincronizadas.
TIMEZONE=America/Lima

# --- API KIA RAG (busqueda semantica de modelos) ---
API_KIA_RAG_URL=http://localhost:8000/buscar

# --- Vitrix CRM (Bitrix24 handlers) ---
# APIKEY_VITRIX es obligatoria para tools de escritura (agendar_cita, agendar_llamada, marcar_desistido).
APIKEY_VITRIX=<REEMPLAZAR>
VITRIX_API_URL=https://b24.guruxdev.com/qm/b24handlers/v2/index.php

# --- LangSmith tracing (opcional) ---
# LangChain/LangGraph las lee automaticamente del ambiente.
# Desactivado por defecto. Activar para observabilidad de traces, tools y LLM calls.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=<tu_langsmith_api_key>
# LANGSMITH_PROJECT="AutoBot"
